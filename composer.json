{
    "name": "bigraja/bulksmsbd",
    "description": "Laravel SMS notification channel for bulksmsbd.net",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Bigraja\\BulkSmsBD\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bigraja\\BulkSmsBD\\BulkSmsBDServiceProvider"
            ],
            "aliases": {
                "BulkSmsBD": "Bigraja\\BulkSmsBD\\Facades\\BulkSmsBD"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}